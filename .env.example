# Copy to .env for `pnpm --filter @ward-sewa/api dev`. Values match docker-compose.yml.
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://ward_sewa:ward_sewa_dev@localhost:5432/ward_sewa
MONGO_URL=mongodb://localhost:27017/ward_sewa
REDIS_URL=redis://localhost:6380
# Signs OTP hashes. Generate your own: openssl rand -base64 48
AUTH_SECRET=dev-only-change-me-dev-only-change-me-0000
