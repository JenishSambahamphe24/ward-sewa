{
  "name": "ward-sewa",
  "private": true,
  "description": "Ward office recommendation-letter (sifaris) service for Nepal's local governments",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @ward-sewa/api test:integration",
    "typecheck": "turbo run typecheck"
  },
  "prettier": "@ward-sewa/config/prettier",
  "devDependencies": {
    "@eslint/js": "catalog:generic",
    "@ward-sewa/config": "workspace:*",
    "eslint": "catalog:generic",
    "eslint-plugin-react-hooks": "catalog:generic",
    "globals": "catalog:generic",
    "prettier": "catalog:generic",
    "turbo": "catalog:generic",
    "typescript": "catalog:generic",
    "typescript-eslint": "catalog:generic"
  }
}
